# ORCA V3 Route Engine Environment Configuration Example
# Copy to .env for local overrides. Do NOT commit actual secrets.

PROJECT_NAME=orca-route-engine
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
ORCA_ROUTE_DB_PATH=data/orca_routes.db

# Provider Selection (options: 'mock', 'incois', 'hycom', 'custom')
OCEAN_PROVIDER=mock
# OCEAN_API_URL=https://api.example-ocean-service.gov.in/v1/conditions
# OCEAN_API_KEY=your_ocean_api_key_here

# Weather Provider Selection (options: 'mock', 'imd', 'gfs', 'custom')
WEATHER_PROVIDER=mock
# WEATHER_API_URL=https://api.example-weather-service.gov.in/v1/forecast
# WEATHER_API_KEY=your_weather_api_key_here

# PFZ Provider Selection (options: 'inmemory', 'teammate_api', 'incois')
PFZ_PROVIDER=inmemory
# PFZ_API_URL=https://api.teammate-pfz-service.internal/v1/zones
# PFZ_API_KEY=your_pfz_api_key_here

# Provider Resilience & Timeout Configurations
PROVIDER_TIMEOUT_SECONDS=5.0
PROVIDER_CONNECT_TIMEOUT_SECONDS=2.0
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_DELAY_SECONDS=0.5
PROVIDER_RETRY_BACKOFF_FACTOR=2.0
PROVIDER_CACHE_TTL_SECONDS=300

# Safety Governor Testing Thresholds (Advisory and Blocking limits)
MAX_TEST_WAVE_HEIGHT_BLOCK_M=4.0
MAX_TEST_WAVE_HEIGHT_WARN_M=2.5
MAX_TEST_WIND_SPEED_BLOCK_KNOTS=35.0
MAX_TEST_WIND_SPEED_WARN_KNOTS=25.0
MIN_TEST_VISIBILITY_BLOCK_KM=0.5
MIN_TEST_VISIBILITY_WARN_KM=3.0
MIN_TEST_UKC_METERS=0.5
